# Copy to .env and fill in. Never commit .env.

FLASK_SECRET_KEY=change-me
PORT=8000

# Required. Supabase: Dashboard -> Connect -> "Session pooler" URI (port 5432), password filled in, e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Uploads go to the private "uploads" Supabase Storage bucket (created by migration b9e4d2a7c315).
# Key: Dashboard -> Project Settings -> API Keys -> secret / service_role. Server-only, never commit.
SUPABASE_URL=https://lzhcjfualozzjjizzjei.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email: "console" logs emails; "smtp" sends through Gmail (or any SMTP server); "ses" sends
# through Amazon SES. Either way each one is recorded in email_log (logged / sent / failed).
EMAIL_BACKEND=console
MAIL_FROM=mentorship@example.org
# Gmail: MAIL_FROM and SMTP_USERNAME = the Gmail address; SMTP_PASSWORD = an app password
# (Google Account -> Security -> 2-Step Verification -> App passwords), not the account password.
SMTP_USERNAME=
SMTP_PASSWORD=
AWS_REGION=us-west-2

# Shared secret for POST /internal/cron/reminders (EventBridge Scheduler calls it).
CRON_SECRET=

# Public URL used in reminder emails
BASE_URL=http://localhost:8000

# LinkedIn PDF import (blank = keyword matching only); planned chatbot, see docs/PLAN.md
ANTHROPIC_API_KEY=

# Embeds the free-text answers so matching can compare them (blank = text answers not scored).
# After setting it, run `flask embed` once to embed answers saved before.
OPENAI_API_KEY=
