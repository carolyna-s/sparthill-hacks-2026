# Copy to .env and fill in. Never commit .env.

FLASK_SECRET_KEY=change-me
PORT=8000

# Leave blank for local SQLite (instance/mentorship.db).
# Supabase: Dashboard -> Connect -> "Session pooler" URI (port 5432), password filled in, e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Uploads: blank = local disk under ./data/uploads; set to use S3.
S3_BUCKET=
AWS_REGION=us-west-2

# Email: "console" logs emails; "ses" sends through Amazon SES.
EMAIL_BACKEND=console
MAIL_FROM=mentorship@example.org

# Shared secret for POST /internal/cron/reminders (EventBridge Scheduler calls it).
CRON_SECRET=

# Public URL used in reminder emails
BASE_URL=http://localhost:8000

# Chatbot + resume extraction (planned, see docs/PLAN.md)
ANTHROPIC_API_KEY=
